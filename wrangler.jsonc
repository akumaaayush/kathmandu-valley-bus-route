{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kathmandu-valley-bus-route",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    // The app lives at / (views are query strings), so unknown paths get a real 404 (public/404.html)
    "not_found_handling": "404-page"
  }
}
